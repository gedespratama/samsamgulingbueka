# Port server lokal
PORT=4000

# Database: file SQLite lokal (default) atau Turso/LibSQL untuk production
# Lokal:  DATABASE_URL=file:data/warung.db
# Turso:  DATABASE_URL=libsql://nama-db.turso.io
#         DATABASE_AUTH_TOKEN=token-turso
DATABASE_URL=file:data/warung.db
DATABASE_AUTH_TOKEN=

# Secret untuk JWT (wajib diganti di production)
JWT_SECRET=ganti-secret-ini

# Set true untuk mematikan autentikasi (hanya untuk dev)
AUTH_DISABLED=false
